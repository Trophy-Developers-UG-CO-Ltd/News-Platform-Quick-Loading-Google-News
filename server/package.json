{
  "name": "mukonotalks-server",
  "version": "1.0.0",
  "description": "MukonoTalks publishing API server",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --coverage --detectOpenHandles",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "seed": "node seeds/seeder.js",
    "seed:cms": "node seeds/seeder.js",
    "seed:admin": "node seeds/seedAdmin.js",
    "seed:developer": "node seeds/seedDeveloper.js",
    "seed:subscriber": "node seeds/seedSubscriber.js",
    "seed:hero": "node seeds/seedHero.js",
    "seed:home": "node seeds/seedHomeSections.js",
    "seed:products": "node seeds/products.seed.js",
    "seed:bulk": "node seeds/importBulkProducts.js",
    "seed:about": "node seeds/seedAboutPage.js",
    "clone:dev": "node scripts/cloneToLocal.js",
    "clone:prod": "node scripts/cloneToProd.js",
    "backup": "node scripts/backup.js",
    "translate:batch": "node scripts/translateBatch.js",
    "translate:batch:force": "node scripts/translateBatch.js --force",
    "translate:batch:dry": "node scripts/translateBatch.js --dry-run",
    "backup:orders": "node scripts/backup.js --collections orders,users,payments"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1011.0",
    "@aws-sdk/lib-storage": "^3.1011.0",
    "@aws-sdk/s3-request-presigner": "^3.1011.0",
    "@google-cloud/translate": "^8.5.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.71.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.4",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.10.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.1",
    "slugify": "^1.6.6",
    "stripe": "^14.9.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "MukonoTalks",
  "license": "UNLICENSED"
}

